DATABASE_URL=sqlite:///./backend/data/app.db
APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 실행 모드: analysis_only | telegram_report | paper_kis | live_disabled
EXECUTION_MODE=paper_kis
ENABLE_REAL_ORDER=false
BROKER_MODE=paper_kis
KIS_ENV=paper
KIS_APP_KEY=<placeholder>
KIS_APP_SECRET=<placeholder>
KIS_ACCESS_TOKEN=<placeholder>
KIS_REFRESH_TOKEN=<placeholder>
KIS_ACCOUNT_NO=<placeholder>
KIS_PRODUCT_CODE=<placeholder>
KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_LIVE_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_PAPER_ACCOUNT_ALIAS=<placeholder>
KIS_TOKEN_CACHE_ENABLED=false
KIS_TOKEN_CACHE_PATH=.cache/kis/token.json
KIS_MARKET_QUOTE_ENABLED=false
KIS_OVERSEAS_EXCHANGE_CODE=NASD
KIS_OVERSEAS_CURRENCY=USD
KIS_OVERSEAS_ORDER_SESSION=regular
KIS_TOKEN_ISSUE_ENABLED=false
KIS_WEBSOCKET_APPROVAL_ENABLED=false
KIS_WEBSOCKET_APPROVAL_KEY=<placeholder>
KIS_PAPER_WS_URL=ws://ops.koreainvestment.com:31000
KIS_HTS_ID=<placeholder>
DISCORD_OPS_WEBHOOK_URL=<placeholder>
# Telegram notifier는 backend/config/notifications.yaml opt-in 전까지 disabled/dry-run 상태입니다.
TELEGRAM_BOT_TOKEN=<placeholder>
TELEGRAM_CHAT_ID=<placeholder>
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_ENABLED=false
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_DRY_RUN=true
TELEGRAM_POLLING_SEND_REPLIES=false
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_PAPER_TRADE_CONFIRM=false
TELEGRAM_REPORT_SCHEDULER_ENABLED=false
TELEGRAM_PRE_MARKET_REPORT_ENABLED=false
TELEGRAM_POST_MARKET_REPORT_ENABLED=false
TELEGRAM_WEEKLY_REPORT_ENABLED=false
TELEGRAM_REPORT_DRY_RUN=true
TELEGRAM_PRE_MARKET_REPORT_TIME=08:30
TELEGRAM_POST_MARKET_REPORT_TIME=16:10
TELEGRAM_WEEKLY_REPORT_TIME=16:30
PAPER_TRADING_ENABLED=true
PAPER_TRADING_CAN_CREATE=true
PAPER_TRADING_NETWORK_ENABLED=true
PAPER_TRADING_MARKET=US
PAPER_TRADING_KILL_SWITCH=false
PAPER_SYMBOL_BLACKLIST=
PAPER_ORDER_COOLDOWN_SECONDS=0
PAPER_SYNC_WORKER_ENABLED=false
PAPER_SYNC_WORKER_INTERVAL_SECONDS=60
PAPER_SYNC_WORKER_MAX_ITERATIONS=1
PAPER_ORDER_SUBMIT_ENABLED=true
PAPER_BOT_CONFIRM=true
PAPER_REALTIME_ENABLED=true
PAPER_REALTIME_REQUIRE_FRESH_QUOTES=true
PAPER_REALTIME_STALE_QUOTE_THRESHOLD_SECONDS=30
PAPER_WEBSOCKET_ENABLED=true
PAPER_WEBSOCKET_CONNECT_ENABLED=false
PAPER_BOT_ENABLED=false
PAPER_BOT_AUTO_SUBMIT=false
PAPER_BOT_SCHEDULER_ENABLED=false
PAPER_BOT_KILL_SWITCH=false
PAPER_BOT_MAX_ITERATIONS=1
PAPER_BOT_MAX_ITERATIONS_CAP=25
PAPER_BOT_STOP_FILE=
PAPER_BOT_MAX_SUBMITS_PER_RUN=1
PAPER_BOT_MAX_ORDER_QTY=1
PAPER_BOT_MAX_ORDER_NOTIONAL=100000
